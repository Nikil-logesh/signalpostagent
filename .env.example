# Signalpost runtime defaults
LLM_ENABLED=false

# NVIDIA OpenAI-compatible endpoint (optional; never required for register-only mode)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# Gemini fallback (optional)
GEMINI_API_KEY=
GEMINI_MODEL=

# Search discovery is disabled by default and remains quarantined unless rights are approved.
BRAVE_SEARCH_API_KEY=

# Runtime budgets
MAX_REQUESTS=2000
MAX_REQUESTS_PER_COMPANY=15
MAX_RUNTIME_SECONDS=2700
MAX_CONCURRENCY=8

# Local state
CACHE_DIR=state/cache
DATABASE_PATH=state/signalpost.sqlite3
